{
  "name": "daybook-life-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Daybook - your private daily Life OS. Habits, money, food, work, and wellness in one place.",
  "scripts": {
    "prebuild": "node scripts/generate-version.mjs",
    "dev": "node scripts/generate-version.mjs && vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "sync:install": "npm install --prefix worker",
    "sync:dev": "npm run dev --prefix worker",
    "sync:deploy": "npm run deploy --prefix worker"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "to-ico": "^1.1.5",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1"
  }
}
