# Copy to `.env` for local dev, or set in Netlify dashboard.

# Optional: external sync worker URL (leave empty to use Netlify Functions)
VITE_SYNC_API_URL=

# Admin key for /logs dashboard (required in production)
# Netlify: Site settings → Environment variables → LOGS_ADMIN_KEY
LOGS_ADMIN_KEY=

# Local dev logs admin key (defaults to "dev-admin" if unset)
VITE_LOGS_ADMIN_KEY=dev-admin
